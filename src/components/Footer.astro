---
import { site, nav } from '~/data/site';

const year = new Date().getFullYear();

const links = [
  ...nav.map((n) => ({ label: n.label, href: n.href, external: false })),
  { label: 'Enquire', href: '/contact', external: false },
  { label: 'Instagram', href: site.instagram, external: true },
  { label: 'Email', href: `mailto:${site.email}`, external: false },
];
---

<footer class="ft">
  <hr class="rule" />
  <div class="shell ft__inner">
    <div class="ft__links">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="link-wipe"
            {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <p class="ft__place muted">Made in {site.location.split(',')[0]}</p>
  </div>

  <div class="shell">
    <p class="ft__legal faint">
      © {year} {site.studio}. All rights reserved. All artwork, illustration and text on
      this site is the copyright of {site.studio} and its clients, and may not be
      reproduced or reused without written permission.
    </p>
  </div>
</footer>

<style>
  .ft { margin-top: clamp(3rem, 7vw, 6rem); }

  .ft__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 3.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
  }

  .ft__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem 1.75rem;
    font-size: var(--text-body);
  }

  .ft__place { font-size: var(--text-body); }

  .ft__legal {
    max-width: 46rem;
    padding-bottom: 2.5rem;
    font-size: var(--text-meta);
    line-height: 1.5;
  }
</style>
