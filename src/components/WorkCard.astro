---
import SuiteArt from '~/components/SuiteArt.astro';
import type { Project } from '~/data/work';

interface Props {
  project: Project;
  /** Rail cards get a fixed width; grid cards fill their column. */
  width?: string;
  delay?: number;
}

const { project, width, delay = 0 } = Astro.props;
const dark = project.tone === 'dark';
---

<a
  href={`/work/${project.slug}`}
  class:list={['card', dark && 'card--dark']}
  style={`${width ? `width:${width};` : ''}--card-ground:${project.ground};--reveal-delay:${delay}ms`}
  data-reveal
>
  <article class="card__frame">
    <div class="card__art">
      <SuiteArt variant={project.variant} />
    </div>

    <div class="card__meta">
      <h3 class="card__name">{project.couple}</h3>
      <ul class="card__tags">
        {project.tags.map((tag) => <li class="card__tag">{tag}</li>)}
      </ul>
    </div>
  </article>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Tall card, close to the reference proportions. */
    aspect-ratio: 69 / 100;
    border-radius: 1.5rem;
    background: var(--card-ground);
    transition: transform 0.55s var(--ease-out-soft);
  }

  .card:hover .card__frame { transform: translateY(-5px); }

  .card__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, #2c2420 7%, transparent);
    pointer-events: none;
  }

  /* Artwork takes the upper portion; the label sits in the space below it. */
  .card__art {
    flex: 1;
    min-height: 0;
    padding: clamp(0.75rem, 1.6vw, 1.5rem);
    padding-bottom: 0;
  }

  .card__art :global(svg) {
    width: 100%;
    height: 100%;
  }

  .card__meta {
    flex: none;
    padding: clamp(0.875rem, 1.5vw, 1.25rem) clamp(1rem, 1.8vw, 1.5rem)
      clamp(1rem, 1.8vw, 1.375rem);
  }

  .card__name {
    font-size: clamp(1rem, 0.94rem + 0.28vw, 1.1875rem);
    font-weight: 400;
    letter-spacing: -0.018em;
    color: var(--color-ink);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.625rem 0 0;
    padding: 0;
    list-style: none;
  }

  .card__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem 0.5rem 0.25rem;
    border: 1px solid color-mix(in oklab, #2c2420 18%, transparent);
    border-radius: 999px;
    font-size: 0.75rem;
    line-height: 1.25;
    color: color-mix(in oklab, #2c2420 72%, transparent);
    white-space: nowrap;
  }

  /* Dark ground — flip the label to light. */
  .card--dark .card__name { color: #fff; }

  .card--dark .card__tag {
    border-color: color-mix(in oklab, #fff 40%, transparent);
    color: color-mix(in oklab, #fff 88%, transparent);
  }
</style>
