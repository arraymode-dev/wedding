---
import WorkCard from '~/components/WorkCard.astro';
import { projects } from '~/data/work';

interface Props {
  /** Hint shown once, for pointer users who may not spot the overflow. */
  label?: string;
}
const { label = 'Selected work' } = Astro.props;
---

<section class="rail-block" aria-label={label}>
  <div class="rail" data-rail>
    {projects.map((p, i) => <WorkCard project={p} width="clamp(16rem, 29vw, 26rem)" delay={i * 60} />)}
  </div>
</section>

<style>
  .rail-block {
    /* Full-bleed: the rail escapes the page gutter so cards run off-screen. */
    position: relative;
    z-index: 1;
    margin-block: 0 clamp(2.5rem, 5vw, 4rem);
  }
</style>
